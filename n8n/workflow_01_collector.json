{
  "name": "PC통신 AI NEWS 01 - Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 6,11,16,21 * * *"
            }
          ]
        }
      },
      "id": "schedule-collector",
      "name": "Schedule 4x Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.PCTONGSIN_SUPABASE_URL + '/rest/v1/news_sources?enabled=eq.true&source_type=eq.rss&select=id,name,source_url,domain,trust_score' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.PCTONGSIN_SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.PCTONGSIN_SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-sources",
      "name": "Get Enabled RSS Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length > 1) return items;\nconst raw = items[0]?.json;\nif (Array.isArray(raw)) return raw.map(row => ({ json: row }));\nreturn items;"
      },
      "id": "expand-sources",
      "name": "Expand Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.source_url }}"
      },
      "id": "rss-read",
      "name": "Read RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const src = $('Expand Sources').item.json;\nconst item = $json;\nconst sourceUrl = item.link || item.guid || item.url;\nif (!sourceUrl || !item.title) return [];\n\nlet canonical = sourceUrl.trim();\ntry {\n  const u = new URL(canonical);\n  ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','ref','source'].forEach(k => u.searchParams.delete(k));\n  u.hash = '';\n  canonical = u.toString();\n} catch {}\n\nconst published = item.isoDate || item.pubDate || item.date || null;\nconst summary = item.contentSnippet || item.content || item.description || null;\nconst image = item.enclosure?.url || item.image?.url || null;\n\nreturn [{\n  json: {\n    p_source_id: src.id,\n    p_source_name: src.name,\n    p_source_url: sourceUrl,\n    p_canonical_url: canonical,\n    p_original_title: item.title,\n    p_original_summary: summary ? String(summary).slice(0, 4000) : null,\n    p_published_at: published,\n    p_image_url: image,\n    p_content_fingerprint: null\n  }\n}];"
      },
      "id": "normalize",
      "name": "Normalize Candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PCTONGSIN_SUPABASE_URL + '/rest/v1/rpc/ingest_news_candidate' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.PCTONGSIN_SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.PCTONGSIN_SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "ingest",
      "name": "Ingest Candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Schedule 4x Daily": {
      "main": [
        [
          {
            "node": "Get Enabled RSS Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Enabled RSS Sources": {
      "main": [
        [
          {
            "node": "Expand Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Sources": {
      "main": [
        [
          {
            "node": "Read RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read RSS": {
      "main": [
        [
          {
            "node": "Normalize Candidate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Candidate": {
      "main": [
        [
          {
            "node": "Ingest Candidate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "timezone": "Asia/Seoul"
  },
  "active": false
}